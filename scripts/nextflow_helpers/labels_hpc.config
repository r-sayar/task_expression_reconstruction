// ---------------------------------------------------------------------------
// SLURM + Apptainer/Singularity HPC label config for run_benchmark.
//
// Maps the Viash resource labels (lowmem/midmem/highmem/veryhighmem,
// low/mid/high cpu, low/mid/high/veryhigh time, gpu) onto SLURM directives.
//
// >>> CLUSTER-SPECIFIC VALUES YOU MUST SET before launching <<<
//   * params.cpu_partition / params.gpu_partition  (SLURM partition/queue names)
//   * params.slurm_account                         (SLURM account, if required)
//   * the Apptainer cache/tmp dirs and bind mounts below (/lustre paths)
//   * the GPU generic resource string (--gres=gpu:1 vs. type-specific)
//   * APPTAINER_BIND_OPTS      -- bind-mount flags, applied to EVERY apptainer
//                                 exec regardless of image (e.g. '--bind /scratch')
//   * RECON_PYTHONPATH_OPTS    -- '--env PYTHONPATH=.../pylibs:.../ReconEval/src
//                                 --env PYTHONDONTWRITEBYTECODE=1', applied ONLY
//                                 to this task's own component runs (see the
//                                 withName: '.*runEachWf.*' / withLabel: gpu
//                                 blocks below). Do NOT fold this into
//                                 APPTAINER_BIND_OPTS / apptainer.runOptions --
//                                 fetched openproblems-bio dependency components
//                                 (e.g. utils/extract_uns_metadata) run in their
//                                 own separate image with their own Python
//                                 version, and an ABI-mismatched PYTHONPATH
//                                 forced onto them fails with a misleading
//                                 "partially initialized module" ImportError.
//
// Usage:
//   nextflow run . \
//     -main-script target/nextflow/workflows/run_benchmark/main.nf \
//     -profile hpc \
//     -c scripts/nextflow_helpers/labels_hpc.config \
//     -params-file params.yaml
// ---------------------------------------------------------------------------

params {
  // override on the command line or in params.yaml
  // Curta defaults: CPU partition is `main`, GPU is `gpu`, QOS `standard` required.
  cpu_partition = System.getenv('SLURM_CPU_PARTITION') ?: 'main'
  gpu_partition = System.getenv('SLURM_GPU_PARTITION') ?: 'gpu'
  slurm_account = System.getenv('SLURM_ACCOUNT') ?: null
  slurm_qos     = System.getenv('SLURM_QOS') ?: 'standard'
  gpu_gres      = System.getenv('SLURM_GPU_GRES') ?: 'gpu:1'
}

profiles {
  hpc {
    process.executor = 'slurm'
    // Throttle concurrent SLURM jobs so we don't hog the shared gpu partition.
    executor.queueSize = (System.getenv('NXF_QUEUE_SIZE') ?: '6') as Integer

    // This task's own components run in one prebuilt "fat" apptainer image
    // (built on Curta via fakeroot; no registry to push per-component images
    // to). NOTE: an UNSCOPED top-level `process.container = ...` here does
    // NOT actually override the per-component image refs viash bakes into
    // each generated process script -- verified empirically: nextflow tried
    // to `apptainer pull` the auto-generated per-component `:dev` tag anyway
    // and failed (that tag is a local-only viash build tag, never pushed to
    // any registry). Script-level container directives beat an unscoped
    // config default. A `withName`/`withLabel` SELECTOR-scoped `container =`
    // assignment (below, in the runEachWf and gpu blocks) DOES take
    // precedence, since selector-scoped process config is Nextflow's
    // highest-priority tier -- that's the actual fix.

    // Apptainer (a.k.a. Singularity) is the usual HPC container runtime.
    apptainer {
      enabled = true
      autoMounts = true
      // Bind mounts only -- safe to apply to EVERY apptainer exec regardless
      // of image. Do NOT put this task's PYTHONPATH here: fetched
      // openproblems-bio dependency components (e.g. utils/extract_uns_metadata)
      // run in their OWN separate image with their own Python version and
      // already-correct dependencies. Forcing this task's Python-3.10-targeted
      // pylibs PYTHONPATH onto a Python-3.12 image loads an ABI-incompatible
      // compiled h5py, which surfaces as a confusing
      // "cannot import name '_errors' from partially initialized module 'h5py'"
      // error that looks like a circular import but is actually an interpreter
      // mismatch. See the withName block below for the correctly-scoped fix.
      // /localscratch must be bound explicitly -- autoMounts only covers
      // /tmp, $HOME, $PWD, none of which is where SLURM's $TMPDIR (used by
      // reconStageScript below to stage pylibs onto node-local disk) lives
      // on Curta. Without this, the container simply can't see the files
      // reconStageScript's beforeScript extracted on the host side -- PATH
      // NOT FOUND inside apptainer feels indistinguishable from a stray
      // typo, so don't skip verifying this bind is actually present.
      runOptions = System.getenv('APPTAINER_BIND_OPTS') ?: '--bind /scratch --bind /localscratch'
      // convert the Docker images (openproblems/base_python:1 + pip layers)
      // to .sif once and cache them here on shared storage.
      cacheDir = System.getenv('APPTAINER_CACHEDIR') ?: '/scratch/sayar99/reconeval/apptainer_cache'
    }
    // keep docker/singularity blocks off on HPC
    docker.enabled = false
    singularity.enabled = false
  }
}

def slurmClusterOptions = {
  def opts = []
  if (params.slurm_account) opts << "--account=${params.slurm_account}"
  if (params.slurm_qos) opts << "--qos=${params.slurm_qos}"
  return opts.join(' ')
}

// Stage the whole slow-import chain (pylibs + ReconEval/src, ~26k files /
// 1.2GB) onto node-local disk before each task runs, instead of importing
// straight off Lustre. Root cause this works around: Lustre is fine for
// large sequential reads (~10-15MB/s here, itself slow but tolerable) but
// punishes many-small-file random access (~1MB/s effective) -- and CPython's
// import machinery does several stat()/open() calls per module across
// anndata/scanpy/decoupler/scvi-tools/torch/..., which turned a plain
// `import decoupler` chain into a 12-20 minute wait. A single sequential
// tar read (one big Lustre read, fast) + local untar (all-local-disk stats/
// opens, fast) sidesteps that entirely. /localscratch is a real local ext4
// disk on every compute node, confirmed on both the main and gpu partitions
// via `srun ... df -h /localscratch`. Deliberately NOT keyed off $TMPDIR:
// the sbatch launcher that starts the controller nextflow process does its
// own `export TMPDIR=$R/tmp` (a Lustre path, for nextflow's/apptainer's own
// scratch needs) before invoking nextflow -- and sbatch propagates the
// submitting shell's environment into each task it submits by default, so a
// per-task script relying on `${TMPDIR:-/tmp}` risks silently inheriting
// that Lustre path instead of getting a fresh per-task local one, with no
// error to reveal it (untested whether Curta's SLURM prolog would overwrite
// an inherited TMPDIR -- not worth depending on either way). SLURM_JOB_ID is
// always freshly assigned per submitted job regardless of what the
// submitting environment exported, so keying the local staging directory
// off it sidesteps the whole question.
// NOTE: this is single-quoted (Groovy non-interpolating string) on purpose
// -- the $VAR references must stay literal text here and only get expanded
// by bash when the generated task script actually runs on its compute node,
// not by Groovy at config-parse time on the submission host.
// Regenerate stage.tar via scripts/nextflow_helpers/build_stage_tar.sh
// whenever pylibs or ReconEval/src changes (e.g. a dependency upgrade).
// Staged copies are left behind on /localscratch after each task (no
// afterScript cleanup) -- with ~166GB free per node and ~2.3GB per copy,
// this is not urgent, but it does mean re-runs on the same node accumulate.
def reconStageScript = '''
STAGE_TAR=${RECON_STAGE_TAR:-/scratch/sayar99/reconeval/stage.tar}
STAGE_DIR=/localscratch/tmp/${USER:-$(id -un)}/reconeval_stage_${SLURM_JOB_ID:-$$}
if [ ! -f "$STAGE_DIR/.ok" ]; then
  mkdir -p "$STAGE_DIR"
  tar -xf "$STAGE_TAR" -C "$STAGE_DIR"
  touch "$STAGE_DIR/.ok"
fi
export RECON_STAGE_PYTHONPATH="$STAGE_DIR/pylibs:$STAGE_DIR/ReconEval/src"
'''

process {
  // conservative retry escalation: OOM/preemption -> bump memory & time
  errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] && task.attempt <= 3 ? 'retry' : 'finish' }
  maxRetries = 3

  clusterOptions = { slurmClusterOptions() }

  // default (unlabelled) processes
  cpus = 2
  memory = { 8.GB * task.attempt }
  time = { 2.h * task.attempt }
  queue = params.cpu_partition

  // ----- CPU -----
  withLabel: lowcpu  { cpus = 4 }
  withLabel: midcpu  { cpus = 16 }
  withLabel: highcpu { cpus = 32 }

  // ----- MEMORY (escalates on retry) -----
  withLabel: lowmem       { memory = { 20.GB * task.attempt } }
  withLabel: midmem       { memory = { 50.GB * task.attempt } }
  withLabel: highmem      { memory = { 100.GB * task.attempt } }
  withLabel: veryhighmem  { memory = { 200.GB * task.attempt } }

  // ----- WALLTIME -----
  withLabel: lowtime      { time = 1.h }
  withLabel: midtime      { time = 4.h }
  withLabel: hightime     { time = 8.h }
  withLabel: veryhightime { time = 24.h }

  // Only this task's own method/control_method/data_processor/metric runs
  // (wrapped in runEachWf by viash's generated run_wf) run in the shared fat
  // image with the pylibs + ReconEval-src PYTHONPATH -- fetched
  // openproblems-bio dependency components (extract_uns_metadata, ...) must
  // NOT get either; they ship their own compatible image and environment.
  // See the apptainer block above for why a blanket process.container /
  // runOptions injection doesn't work; selector-scoped assignments here are
  // what actually takes precedence over a component's own baked-in
  // container ref. Must appear BEFORE withLabel: gpu below: Nextflow applies
  // matching selectors in file order, later ones winning on shared
  // directives, and GPU-labeled components are always ALSO runEachWf --
  // gpu's container/containerOptions (which must add '--nv') has to be the
  // last word, so it merges this block's values in itself rather than
  // relying on this block to run after it.
  withName: '.*runEachWf.*' {
    container = System.getenv('RECON_SIF') ?: '/scratch/sayar99/reconeval/images/recon.sif'
    beforeScript = reconStageScript
    containerOptions = System.getenv('RECON_PYTHONPATH_OPTS') ?:
      '--env PYTHONPATH=$RECON_STAGE_PYTHONPATH --env PYTHONDONTWRITEBYTECODE=1'
  }

  // ----- GPU -----
  // The large models (latent 2048 / width 4096) need a GPU and high memory.
  // Route them to the GPU partition and request a GPU via SLURM --gres.
  withLabel: gpu {
    queue = params.gpu_partition
    // NOTE: params.gpu_gres (set via the params{} block above, same pattern
    // as slurm_qos/slurm_account which DO resolve here) was empirically
    // observed to evaluate to Groovy null inside this closure on curta
    // (Nextflow 24.04.2/24.10.5), producing a literal `--gres=null` that
    // SLURM rejects -- root cause not fully isolated (a scoping quirk of
    // this specific key in this closure, not a params{} block problem in
    // general). Read the env var directly here instead, matching the
    // already-reliable RECON_SIF/RECON_PYTHONPATH_OPTS pattern below.
    clusterOptions = { (slurmClusterOptions() + " --gres=" + (System.getenv('SLURM_GPU_GRES') ?: 'gpu:1')).trim() }
    // Apptainer needs --nv to expose the GPU inside the container. GPU-labeled
    // components (autoencoder/scvi) are always this task's own and always
    // runEachWf-wrapped, so this block -- appearing AFTER withName:
    // '.*runEachWf.*' above and therefore taking precedence for container/
    // containerOptions (and, empirically, beforeScript too -- duplicated
    // defensively here rather than relying on it falling through from the
    // block above) on the same process -- must also carry that block's
    // container + PYTHONPATH injection itself, or it would silently drop
    // back to the component's own (nonexistent, unpushed) per-component
    // image ref and just '--nv', losing both the shared fat image and the
    // pylibs/ReconEval-src environment. GPU nodes (g001-g008) were confirmed
    // to have the same /localscratch + $TMPDIR local-disk setup as the main
    // partition, so reconStageScript works unchanged here too.
    beforeScript = reconStageScript
    container = System.getenv('RECON_SIF') ?: '/scratch/sayar99/reconeval/images/recon.sif'
    containerOptions = {
      def pythonpathOpts = System.getenv('RECON_PYTHONPATH_OPTS') ?:
        '--env PYTHONPATH=$RECON_STAGE_PYTHONPATH --env PYTHONDONTWRITEBYTECODE=1'
      ('--nv ' + pythonpathOpts).trim()
    }
    cpus = 16
    // memory/time come from the other labels the component also carries
    // (e.g. [hightime, highmem, midcpu, gpu]); bump the big models on retry.
    memory = { 100.GB * task.attempt }
    time = { 12.h * task.attempt }
  }

  // publishStates needs a bit of headroom
  withName: '.*publishStatesProc' {
    memory = '16.GB'
    time = '1.h'
  }
}

// tracing
trace {
  enabled = true
  overwrite = true
  file = "${params.publish_dir}/trace.txt"
}
report {
  enabled = true
  overwrite = true
  file = "${params.publish_dir}/report.html"
}
